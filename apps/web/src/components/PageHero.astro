---
/**
 * Shared hero for inner pages: soft peach stage, drifting glows, a word-by-word headline
 * and a light CSS 3D object (a glass verifier cube inside orbiting rings with device tiles).
 * No WebGL here, so every page stays fast; the landing page carries the full 3D scene.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  compact?: boolean;
}
const { eyebrow, title, lead, compact = false } = Astro.props;
---
<section class:list={["px-2 pt-2 sm:px-4 sm:pt-3", compact ? "mb-6" : "mb-10 sm:mb-14"]}>
  <div class:list={["ph-stage grain relative isolate overflow-hidden rounded-[28px] sm:rounded-[36px]", compact ? "ph-compact" : ""]}>
    <div aria-hidden="true" class="ph-glow ph-glow-a"></div>
    <div aria-hidden="true" class="ph-glow ph-glow-b"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 opacity-[0.35] [background-image:linear-gradient(rgba(255,255,255,.05)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.05)_1px,transparent_1px)] [background-size:48px_48px] [mask-image:radial-gradient(60%_80%_at_75%_40%,black,transparent)]"></div>

    <div aria-hidden="true" class="ph-obj">
      <div class="ph-scene">
        <div class="ph-core"></div>
        <div class="ph-ring ph-r1"><i></i><i></i></div>
        <div class="ph-ring ph-r2"><i></i></div>
        <div class="ph-ring ph-r3"><i></i><i></i></div>
        <div class="ph-cube">
          <span class="f1"></span><span class="f2"></span><span class="f3"></span>
          <span class="f4"></span><span class="f5"></span><span class="f6"></span>
        </div>
      </div>
    </div>

    <div class:list={["relative mx-auto max-w-7xl px-4 sm:px-8", compact ? "pb-8 pt-8 sm:pb-10 sm:pt-10" : "pb-12 pt-12 sm:pb-16 sm:pt-16"]}>
      {(eyebrow || Astro.slots.has("eyebrow")) && (
        <p data-reveal class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.18em] text-charcoal-60 backdrop-blur">
          <span class="relative inline-flex size-1.5"><span class="ping absolute inset-0 rounded-full bg-orange"></span><span class="relative size-1.5 rounded-full bg-orange"></span></span>
          {Astro.slots.has("eyebrow") ? <slot name="eyebrow" /> : eyebrow}
        </p>
      )}
      <h1 data-split class:list={["mt-4 max-w-3xl font-bold tracking-tight", compact ? "text-3xl sm:text-4xl" : "text-4xl leading-[1.05] sm:text-6xl"]}>{title}</h1>
      {lead && <p data-reveal style="--fx-delay:260ms" class="mt-5 max-w-2xl text-lg text-charcoal-80">{lead}</p>}
      {Astro.slots.has("default") && <div data-reveal style="--fx-delay:380ms" class="mt-6"><slot /></div>}
    </div>
  </div>
</section>

<style>
  .ph-stage { background: linear-gradient(135deg, #131824 0%, #0e1119 55%, #1a130f 100%); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.05); }
  .ph-glow { position: absolute; z-index: -10; border-radius: 9999px; filter: blur(60px); pointer-events: none; }
  .ph-glow-a { width: 26rem; height: 26rem; right: -6rem; top: -8rem; background: rgb(255 122 69 / 0.22); animation: ph-drift 14s ease-in-out infinite; }
  .ph-glow-b { width: 18rem; height: 18rem; left: 30%; bottom: -10rem; background: rgb(96 120 255 / 0.14); animation: ph-drift 18s ease-in-out infinite reverse; }
  @keyframes ph-drift { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(-40px, 30px); } }

  /* 3D object */
  .ph-obj { position: absolute; z-index: -5; right: -3rem; top: 50%; width: 18.75rem; height: 18.75rem; transform: translateY(-50%); perspective: 900px; opacity: 0.45; pointer-events: none; }
  @media (max-width: 767px) { .ph-obj { top: 4.5rem; right: -6rem; width: 220px; height: 220px; transform: none; opacity: 0.3; } }
  @media (min-width: 768px) { .ph-obj { right: 4%; opacity: 1; } }
  @media (min-width: 1280px) { .ph-obj { right: 9%; width: 21.25rem; height: 21.25rem; } }
  .ph-compact .ph-obj { width: 200px; height: 200px; }
  @media (max-width: 767px) { .ph-compact .ph-obj { display: none; } }
  .ph-scene { position: absolute; inset: 0; transform-style: preserve-3d; animation: ph-sway 12s ease-in-out infinite; }
  @keyframes ph-sway { 0%, 100% { transform: rotateX(14deg) rotateY(-18deg); } 50% { transform: rotateX(-6deg) rotateY(18deg); } }

  .ph-core { position: absolute; left: 50%; top: 50%; width: 46%; height: 46%; transform: translate(-50%, -50%); border-radius: 9999px; background: radial-gradient(circle, rgb(255 122 69 / 0.6), rgb(255 122 69 / 0) 70%); animation: ph-pulse 3.2s ease-in-out infinite; }
  @keyframes ph-pulse { 0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(0.9); } 50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); } }

  .ph-ring { position: absolute; inset: 6%; border-radius: 9999px; border: 1px solid rgb(255 255 255 / 0.14); transform-style: preserve-3d; }
  .ph-ring i { position: absolute; left: 50%; top: -9px; width: 12px; height: 18px; margin-left: -6px; border-radius: 3px; background: #0b0d12; box-shadow: inset 0 0 0 1.5px #2a3142, inset 0 0 0 3px #ff7a45, 0 0 12px rgb(255 122 69 / 0.6); }
  .ph-ring i:nth-child(2) { top: auto; bottom: -9px; }
  .ph-r1 { animation: ph-r1 16s linear infinite; }
  .ph-r2 { inset: 0; border-color: rgb(255 122 69 / 0.45); border-style: dashed; animation: ph-r2 22s linear infinite; }
  .ph-r3 { inset: 14%; animation: ph-r3 12s linear infinite; }
  @keyframes ph-r1 { from { transform: rotateX(72deg) rotateZ(0); } to { transform: rotateX(72deg) rotateZ(360deg); } }
  @keyframes ph-r2 { from { transform: rotateY(70deg) rotateZ(0); } to { transform: rotateY(70deg) rotateZ(-360deg); } }
  @keyframes ph-r3 { from { transform: rotateX(-40deg) rotateY(30deg) rotateZ(0); } to { transform: rotateX(-40deg) rotateY(30deg) rotateZ(360deg); } }

  .ph-cube { --s: 78px; position: absolute; left: 50%; top: 50%; width: var(--s); height: var(--s); margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2); transform-style: preserve-3d; animation: ph-cube 14s linear infinite; }
  .ph-compact .ph-cube { --s: 52px; }
  .ph-cube span { position: absolute; inset: 0; border-radius: 14px; border: 1.5px solid rgb(255 122 69 / 0.9); background: linear-gradient(135deg, rgb(255 255 255 / 0.10), rgb(255 122 69 / 0.08)); box-shadow: inset 0 0 22px rgb(255 122 69 / 0.35), 0 0 18px rgb(255 122 69 / 0.15); }
  .ph-cube .f1 { transform: translateZ(calc(var(--s) / 2)); }
  .ph-cube .f2 { transform: rotateY(180deg) translateZ(calc(var(--s) / 2)); }
  .ph-cube .f3 { transform: rotateY(90deg) translateZ(calc(var(--s) / 2)); }
  .ph-cube .f4 { transform: rotateY(-90deg) translateZ(calc(var(--s) / 2)); }
  .ph-cube .f5 { transform: rotateX(90deg) translateZ(calc(var(--s) / 2)); background: rgb(255 122 69 / 0.35); }
  .ph-cube .f6 { transform: rotateX(-90deg) translateZ(calc(var(--s) / 2)); }
  @keyframes ph-cube { from { transform: rotateX(-22deg) rotateY(0); } to { transform: rotateX(-22deg) rotateY(360deg); } }
</style>
