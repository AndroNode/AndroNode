---
/**
 * Home "one task, end to end" section: an interactive pipeline. A packet travels node to node
 * on its own (paused on hover, or with the button), and each step opens a small live visual.
 * Clicking a node jumps to it. Values come from the protocol package, so the numbers stay true.
 */
import { allocate, perRecordCharge, formatUnits } from "@andronode/protocol/money";
import { PRICING } from "@andronode/protocol/params";

const split = allocate(perRecordCharge(PRICING.illustrativeRatePer1kUnits) * 64n);
const contributor = formatUnits(split.contributor);
const service = formatUnits(split.service);

const steps = [
  { t: "Device", d: "Plugged in, on Wi-Fi, owner-set limits.", more: "Work only starts while the phone is charging, on an unmetered network, and inside the battery and heat limits its owner set.", icon: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>' },
  { t: "Lease", d: "A complete small task, 120 s to finish.", more: "The coordinator leases one whole task to one device. If the lease runs out, the task goes back to the queue and nothing is paid.", icon: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5M9.5 2.5h5"/>' },
  { t: "Compute", d: "Embeddings run on the phone's CPU.", more: "Up to 64 records of at most 256 tokens each. Every record comes back as a 384-number vector.", icon: '<rect x="6" y="6" width="12" height="12" rx="2"/><rect x="9.5" y="9.5" width="5" height="5" rx="1"/><path d="M9 2.5v3M15 2.5v3M9 18.5v3M15 18.5v3M2.5 9h3M2.5 15h3M18.5 9h3M18.5 15h3"/>' },
  { t: "Verify", d: "A trusted verifier recomputes every vector.", more: "In the first paid design every output is recomputed and compared within published tolerances. Only matching records are accepted.", icon: '<path d="M12 2.5 4.5 5.5v6c0 4.6 3.2 8.6 7.5 10 4.3-1.4 7.5-5.4 7.5-10v-6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>' },
  { t: "Paid", d: "Accepted records split 75 / 25.", more: "The customer is charged only for accepted records: 75% goes to the contributor, 25% to the service pool.", icon: '<circle cx="12" cy="12" r="9"/><path d="M14.8 9.2c-.5-.9-1.6-1.4-2.8-1.4-1.6 0-2.8.8-2.8 2.1 0 2.9 5.8 1.4 5.8 4.3 0 1.3-1.3 2.1-3 2.1-1.3 0-2.4-.6-2.9-1.5M12 6v1.8M12 16.2V18"/>' },
];
const checks = [["Charging", "External power"], ["Network", "Unmetered Wi-Fi"], ["Battery", "92% · limit 30%"], ["Temperature", "31 °C · limit 40 °C"]];
const lease = ["task_id    demo-task-0001", "records    64", "max_tokens 256", "output     384-number vector", "lease      120 s"];
const rows = [[62, 30, 78, 44], [40, 85, 26, 58], [74, 52, 66, 35], [28, 70, 48, 82], [56, 38, 90, 46], [80, 60, 34, 70]];
---
<section id="flow" class="mx-auto max-w-7xl px-4 py-24 sm:px-6" aria-labelledby="flow-h">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-charcoal-60">One task, end to end</p>
      <h2 id="flow-h" data-split class="mt-3 max-w-3xl text-4xl font-bold leading-[1.02] tracking-[-0.035em] sm:text-6xl">From an idle phone to a checked, paid result.</h2>
    </div>
    <div data-reveal class="flex items-center gap-3">
      <p class="font-mono text-xs text-charcoal-60">Step <span id="fp-count" class="text-charcoal">1</span> / 5 · click any step</p>
      <button id="fp-toggle" type="button" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-white/60 px-4 text-sm font-bold hover:border-orange/60" aria-pressed="false">
        <svg class="fp-ico-pause size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg class="fp-ico-play size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5.5v13a1 1 0 0 0 1.5.9l10.5-6.5a1 1 0 0 0 0-1.7L8.5 4.6A1 1 0 0 0 7 5.5z"/></svg>
        <span class="fp-toggle-label">Pause</span>
      </button>
    </div>
  </div>

  <div id="fp" data-a="0" style="--a:0" data-reveal="scale" class="fp-stage relative isolate mt-12 overflow-hidden rounded-[28px] border border-line">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 opacity-60 [background-image:linear-gradient(rgba(255,255,255,.04)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.04)_1px,transparent_1px)] [background-size:40px_40px] [mask-image:radial-gradient(70%_90%_at_50%_30%,black,transparent)]"></div>
    <div aria-hidden="true" class="fp-glow"></div>

    <!-- Track and nodes -->
    <div class="px-3 pt-8 sm:px-8 sm:pt-10">
      <div class="relative">
      <div aria-hidden="true" class="fp-track"><span class="fp-fill"></span><span class="fp-packet"><i></i></span></div>
      <div role="tablist" aria-label="Pipeline steps" class="relative grid grid-cols-5">
        {steps.map((s, i) => (
          <button type="button" role="tab" id={`fp-tab-${i}`} aria-controls="fp-panel" aria-selected={i === 0 ? "true" : "false"} data-fp={i} class="fp-node group flex flex-col items-center gap-3 rounded-2xl px-1 pb-2 text-center">
            <span class="fp-tile relative grid size-12 place-items-center rounded-2xl border sm:size-16">
              <span aria-hidden="true" class="fp-halo"></span>
              <svg viewBox="0 0 24 24" class="relative size-5 sm:size-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
            </span>
            <span class="font-mono text-[10px] text-charcoal-60 sm:text-xs">0{i + 1}</span>
            <span class="fp-label font-display hidden text-sm font-semibold sm:block sm:text-base">{s.t}</span>
          </button>
        ))}
      </div>
      </div>
    </div>

    <!-- Active step -->
    <div id="fp-panel" role="tabpanel" aria-live="polite" class="relative grid items-center gap-8 px-5 pb-12 pt-8 sm:px-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-14 lg:pb-14">
      <div class="grid">
        {steps.map((s, i) => (
          <div class="fp-pane [grid-area:1/1]" data-s={i}>
            <p class="font-mono text-xs uppercase tracking-[0.18em] text-orange">Step 0{i + 1}</p>
            <h3 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{s.t}</h3>
            <p class="mt-3 text-lg text-charcoal">{s.d}</p>
            <p class="mt-3 max-w-md text-sm leading-relaxed text-charcoal-80">{s.more}</p>
          </div>
        ))}
      </div>

      <div aria-hidden="true" class="fp-screen relative grid min-h-[17rem] rounded-[22px] border border-snow/[0.07] bg-[#0b0e15]/80 p-5 shadow-[0_30px_80px_-40px_rgba(255,122,69,0.6)] sm:p-7">
        <!-- 0 · Device check -->
        <div class="fp-pane [grid-area:1/1] grid items-center gap-6 sm:grid-cols-[auto_1fr]" data-s="0">
          <div class="relative mx-auto h-44 w-24 rounded-[18px] border-2 border-snow/15 bg-[#0f131c] p-2">
            <div class="mx-auto h-1 w-6 rounded-full bg-snow/15"></div>
            <div class="mt-6 grid place-items-center">
              <svg viewBox="0 0 24 24" class="fp-bolt size-8 text-orange" fill="currentColor"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
            </div>
            <div class="absolute inset-x-3 bottom-4 h-14 overflow-hidden rounded-md border border-snow/15">
              <div class="fp-batt absolute inset-x-0 bottom-0 bg-gradient-to-t from-orange to-orange-deep"></div>
              <p class="relative grid h-full place-items-center font-mono text-xs font-bold text-snow">92%</p>
            </div>
          </div>
          <ul class="grid gap-2.5">
            {checks.map(([k, v], j) => (
              <li class="fp-row flex items-center gap-3 rounded-xl border border-snow/[0.06] bg-snow/[0.03] px-3 py-2.5" style={`--j:${j}`}>
                <span class="fp-tick grid size-6 shrink-0 place-items-center rounded-full bg-orange text-ink"><svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
                <span class="text-sm font-bold">{k}</span>
                <span class="ml-auto font-mono text-xs text-charcoal-60">{v}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- 1 · Lease -->
        <div class="fp-pane [grid-area:1/1] grid items-center gap-6 sm:grid-cols-[auto_1fr]" data-s="1">
          <div class="relative mx-auto size-36">
            <svg viewBox="0 0 100 100" class="absolute inset-0 -rotate-90">
              <circle cx="50" cy="50" r="44" fill="none" stroke="rgb(255 255 255 / 0.08)" stroke-width="6" />
              <circle class="fp-lease-ring" cx="50" cy="50" r="44" fill="none" stroke="#ff7a45" stroke-width="6" stroke-linecap="round" pathLength="100" stroke-dasharray="100" />
            </svg>
            <div class="absolute inset-0 grid place-items-center text-center">
              <div><p class="font-display text-4xl font-bold tabular-nums"><span id="fp-lease">120</span></p><p class="font-mono text-[10px] uppercase tracking-widest text-charcoal-60">seconds left</p></div>
            </div>
          </div>
          <div class="rounded-xl border border-snow/[0.06] bg-black/30 p-4 font-mono text-xs leading-6 sm:text-sm">
            <p class="text-charcoal-60">// lease granted</p>
            {lease.map((l, j) => <p class="fp-type whitespace-pre text-snow/90" style={`--j:${j}`}>{l}</p>)}
          </div>
        </div>

        <!-- 2 · Compute -->
        <div class="fp-pane [grid-area:1/1] grid items-center gap-6 sm:grid-cols-[auto_1fr]" data-s="2">
          <div class="mx-auto">
            <div class="fp-cells grid grid-cols-8 gap-1.5">
              {Array.from({ length: 64 }, (_, j) => <i style={`--j:${j}`}></i>)}
            </div>
            <p class="mt-3 text-center font-mono text-xs text-charcoal-60"><span id="fp-done">0</span> / 64 records</p>
          </div>
          <div class="min-w-0">
            <p class="font-mono text-[11px] uppercase tracking-widest text-charcoal-60">Record vector · 384 numbers</p>
            <p id="fp-vec" class="mt-2 break-all font-mono text-sm leading-6 text-orange-deep">[0.0213, -0.1182, 0.0447, 0.0912, -0.0365, …]</p>
            <div class="mt-5 grid gap-2">
              {["CPU thread 1", "CPU thread 2"].map((c, j) => (
                <div>
                  <div class="flex justify-between font-mono text-[11px] text-charcoal-60"><span>{c}</span><span>busy</span></div>
                  <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-snow/10"><div class="fp-cpu h-full rounded-full bg-orange" style={`--j:${j}`}></div></div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- 3 · Verify -->
        <div class="fp-pane [grid-area:1/1]" data-s="3">
          <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-x-3 gap-y-2 font-mono text-[11px] text-charcoal-60">
            <p>Device result</p><span></span><p class="text-right">Verifier recompute</p>
            {rows.map((r, j) => (
              <>
                <div class="fp-vrow flex h-6 items-center gap-1" style={`--j:${j}`}>{r.map((w) => <i class="h-2 rounded-full bg-snow/25" style={`width:${w / 4}%`}></i>)}</div>
                <span class="fp-vtick grid size-6 place-items-center rounded-full border border-orange/60 text-orange" style={`--j:${j}`}><svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg></span>
                <div class="fp-vrow flex h-6 items-center justify-end gap-1" style={`--j:${j}`}>{r.map((w) => <i class="h-2 rounded-full bg-orange/70" style={`width:${w / 4}%`}></i>)}</div>
              </>
            ))}
          </div>
          <div class="fp-verdict mt-5 flex items-center justify-between rounded-xl border border-orange/40 bg-orange/10 px-4 py-3">
            <span class="text-sm font-bold">64 / 64 within tolerance</span>
            <span class="rounded-full bg-orange px-2.5 py-0.5 font-mono text-[11px] font-bold text-ink">ACCEPTED</span>
          </div>
        </div>

        <!-- 4 · Paid -->
        <div class="fp-pane [grid-area:1/1] self-center" data-s="4">
          <p class="font-mono text-[11px] uppercase tracking-widest text-charcoal-60">Illustrative · 64 accepted records at $0.20 / 1,000</p>
          <p class="font-display mt-3 text-4xl font-bold tabular-nums sm:text-5xl"><span id="fp-paid" data-to={contributor}>{contributor}</span> <span class="text-xl text-charcoal-60">USDC</span></p>
          <p class="mt-1 text-sm text-charcoal-80">to the contributor</p>
          <div class="mt-6 flex h-4 overflow-hidden rounded-full bg-snow/10">
            <div class="fp-split-a h-full bg-gradient-to-r from-orange to-orange-deep"></div>
            <div class="fp-split-b h-full bg-snow/30"></div>
          </div>
          <div class="mt-3 flex justify-between font-mono text-xs">
            <span><span class="text-orange">■</span> Contributor 75% · {contributor}</span>
            <span><span class="text-snow/40">■</span> Service pool 25% · {service}</span>
          </div>
          <div class="fp-coins pointer-events-none absolute right-6 top-6 hidden sm:block">
            {[0, 1, 2, 3, 4].map((j) => <i style={`--j:${j}`}></i>)}
          </div>
        </div>
      </div>
    </div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-[3px] bg-snow/5"><span id="fp-timer" class="block h-full origin-left bg-orange"></span></div>
  </div>
</section>

<style>
  .fp-stage { background: radial-gradient(120% 90% at 50% 0%, #161b28 0%, #0e1119 60%, #0b0d12 100%); }
  .fp-glow { position: absolute; z-index: -10; left: calc(10% + var(--a) * 20%); top: -10rem; width: 26rem; height: 22rem; translate: -50% 0; border-radius: 9999px; background: rgb(255 122 69 / 0.16); filter: blur(70px); transition: left 900ms cubic-bezier(0.65, 0, 0.35, 1); pointer-events: none; }

  /* Track spans the centres of the first and last node (10% to 90%). */
  .fp-track { position: absolute; left: 10%; right: 10%; top: 1.5rem; height: 2px; background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.14) 0 6px, transparent 6px 12px); background-size: 12px 2px; animation: fp-dash 1.2s linear infinite; }
  @media (min-width: 640px) { .fp-track { top: 2rem; } }
  @keyframes fp-dash { to { background-position: 12px 0; } }
  .fp-fill { position: absolute; left: 0; top: -1px; height: 4px; width: calc(var(--a) * 25%); border-radius: 4px; background: linear-gradient(90deg, rgb(255 122 69 / 0.3), #ff7a45); box-shadow: 0 0 14px rgb(255 122 69 / 0.7); transition: width 900ms cubic-bezier(0.65, 0, 0.35, 1); }
  .fp-packet { position: absolute; top: 1px; left: calc(var(--a) * 25%); transition: left 900ms cubic-bezier(0.65, 0, 0.35, 1); }
  .fp-packet i { position: absolute; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 9999px; background: #fff; box-shadow: 0 0 0 4px rgb(255 122 69 / 0.35), 0 0 22px 6px rgb(255 122 69 / 0.8); animation: fp-beat 1.1s ease-in-out infinite; }
  @keyframes fp-beat { 50% { transform: scale(1.35); } }

  .fp-node { cursor: pointer; outline: none; }
  .fp-tile { border-color: var(--color-line); background: #0f131c; color: rgb(236 238 243 / 0.55); transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), background 400ms ease, border-color 400ms ease, color 400ms ease, box-shadow 400ms ease; }
  .fp-node:hover .fp-tile, .fp-node:focus-visible .fp-tile { transform: translateY(-4px); border-color: rgb(255 122 69 / 0.6); color: var(--color-snow); }
  .fp-node:focus-visible .fp-tile { box-shadow: 0 0 0 3px rgb(255 122 69 / 0.5); }
  .fp-label { color: rgb(236 238 243 / 0.55); transition: color 300ms ease; }
  .fp-halo { position: absolute; inset: -6px; border-radius: 1.3rem; border: 1px solid rgb(255 122 69 / 0.6); opacity: 0; }
  .fp-node[aria-selected="true"] .fp-tile { transform: translateY(-4px) scale(1.08); background: linear-gradient(145deg, #ff9466, #ff7a45); border-color: #ffb08c; color: var(--color-ink); box-shadow: 0 14px 40px -8px rgb(255 122 69 / 0.75); }
  .fp-node[aria-selected="true"] .fp-halo { animation: fp-halo 1.6s ease-out infinite; }
  .fp-node[aria-selected="true"] .fp-label { color: var(--color-snow); }
  .fp-node.done .fp-tile { border-color: rgb(255 122 69 / 0.55); color: #ff9466; }
  @keyframes fp-halo { 0% { opacity: 0.9; transform: scale(0.9); } 100% { opacity: 0; transform: scale(1.35); } }

  /* Panes: all share one grid cell so the height never jumps. */
  .fp-pane { opacity: 0; visibility: hidden; transform: translateY(12px); transition: opacity 450ms ease, transform 600ms cubic-bezier(0.16, 1, 0.3, 1), visibility 0s linear 450ms; }
  #fp[data-a="0"] .fp-pane[data-s="0"], #fp[data-a="1"] .fp-pane[data-s="1"], #fp[data-a="2"] .fp-pane[data-s="2"], #fp[data-a="3"] .fp-pane[data-s="3"], #fp[data-a="4"] .fp-pane[data-s="4"] { opacity: 1; visibility: visible; transform: none; transition-delay: 120ms, 120ms, 0s; }

  /* Step visuals. Each plays when its pane opens (the script restarts them). */
  .fp-bolt { animation: fp-bolt 1.4s ease-in-out infinite; }
  @keyframes fp-bolt { 50% { opacity: 0.35; transform: scale(0.9); } }
  .fp-batt { height: 92%; animation: fp-batt 1.8s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes fp-batt { from { height: 10%; } }
  .fp-row { animation: fp-rise 500ms cubic-bezier(0.16, 1, 0.3, 1) both; animation-delay: calc(200ms + var(--j) * 260ms); }
  .fp-tick { animation: fp-pop 400ms cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(450ms + var(--j) * 260ms); }
  @keyframes fp-rise { from { opacity: 0; transform: translateX(-10px); } }
  @keyframes fp-pop { from { transform: scale(0); } }

  .fp-lease-ring { stroke-dashoffset: 28; animation: fp-drain 3.4s linear both; }
  @keyframes fp-drain { from { stroke-dashoffset: 0; } }
  .fp-type { animation: fp-type 500ms steps(18) both; animation-delay: calc(150ms + var(--j) * 220ms); clip-path: inset(0 0 0 0); }
  @keyframes fp-type { from { clip-path: inset(0 100% 0 0); } }

  .fp-cells i { display: block; width: 0.9rem; height: 0.9rem; border-radius: 3px; background: rgb(255 255 255 / 0.07); animation: fp-cell 300ms ease both; animation-delay: calc(100ms + var(--j) * 38ms); }
  @keyframes fp-cell { from { background: rgb(255 255 255 / 0.07); box-shadow: none; } to { background: #ff7a45; box-shadow: 0 0 8px rgb(255 122 69 / 0.6); } }
  .fp-cpu { width: 80%; animation: fp-cpu 900ms ease-in-out infinite alternate; animation-delay: calc(var(--j) * -450ms); }
  @keyframes fp-cpu { from { width: 55%; } to { width: 95%; } }

  .fp-vrow { animation: fp-rise 450ms ease both; animation-delay: calc(100ms + var(--j) * 260ms); }
  .fp-vrow:nth-child(3n) { animation-name: fp-rise-r; }
  @keyframes fp-rise-r { from { opacity: 0; transform: translateX(10px); } }
  .fp-vtick { animation: fp-tickon 400ms cubic-bezier(0.34, 1.56, 0.64, 1) both; animation-delay: calc(350ms + var(--j) * 260ms); }
  @keyframes fp-tickon { from { transform: scale(0); background: transparent; } to { background: rgb(255 122 69 / 0.15); } }
  .fp-verdict { animation: fp-rise 500ms ease both 1.9s; }

  .fp-split-a { width: 75%; animation: fp-grow 1.2s cubic-bezier(0.16, 1, 0.3, 1) both 200ms; }
  .fp-split-b { width: 25%; animation: fp-grow 1.2s cubic-bezier(0.16, 1, 0.3, 1) both 500ms; }
  @keyframes fp-grow { from { width: 0; } }
  .fp-coins i { position: absolute; right: calc(var(--j) * 18px); top: 0; width: 22px; height: 22px; border-radius: 9999px; background: radial-gradient(circle at 35% 30%, #ffd2b8, #ff7a45 60%, #c2552a); box-shadow: 0 0 14px rgb(255 122 69 / 0.6); animation: fp-coin 2.2s cubic-bezier(0.16, 1, 0.3, 1) infinite; animation-delay: calc(var(--j) * 0.35s); opacity: 0; }
  @keyframes fp-coin { 0% { opacity: 0; transform: translateY(40px) scale(0.6); } 25% { opacity: 1; } 100% { opacity: 0; transform: translateY(-30px) scale(1); } }

  #fp-toggle .fp-ico-play { display: none; }
  #fp-toggle[aria-pressed="true"] .fp-ico-play { display: block; }
  #fp-toggle[aria-pressed="true"] .fp-ico-pause { display: none; }
</style>

<script>
  import { motionAllowed } from "../lib/motion";

  const STEP_MS = 3800;

  function initFlow() {
    const root = document.getElementById("fp");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-fp]")];
    const count = document.getElementById("fp-count");
    const timer = document.getElementById("fp-timer");
    const toggle = document.getElementById("fp-toggle");
    const toggleLabel = toggle?.querySelector(".fp-toggle-label");
    const lease = document.getElementById("fp-lease");
    const done = document.getElementById("fp-done");
    const vec = document.getElementById("fp-vec");
    const paid = document.getElementById("fp-paid");
    const paidTo = Number(paid?.dataset.to ?? 0);

    let a = 0, t0 = performance.now(), elapsedAtPause = 0;
    let visible = false, hovering = false, paused = !motionAllowed(), raf = 0;

    const setToggle = () => {
      toggle?.setAttribute("aria-pressed", String(paused));
      if (toggleLabel) toggleLabel.textContent = paused ? "Play" : "Pause";
    };
    setToggle();

    const go = (i: number) => {
      a = (i + tabs.length) % tabs.length;
      root.dataset.a = String(a);
      root.style.setProperty("--a", String(a));
      tabs.forEach((b, j) => { b.setAttribute("aria-selected", String(j === a)); b.classList.toggle("done", j < a); b.tabIndex = j === a ? 0 : -1; });
      if (count) count.textContent = String(a + 1);
      root.querySelectorAll<HTMLElement>(`.fp-pane[data-s="${a}"]`).forEach((p) => p.getAnimations({ subtree: true }).forEach((x) => { x.cancel(); x.play(); }));
      t0 = performance.now();
      elapsedAtPause = 0;
    };

    const fmt = (v: number) => v.toFixed(6);
    const rnd = () => (Math.random() * 0.24 - 0.12).toFixed(4);
    const tick = (now: number) => {
      raf = 0;
      if (!visible) return;
      const running = !paused && !hovering;
      const el = running ? now - t0 : elapsedAtPause;
      if (running) elapsedAtPause = el; else t0 = now - elapsedAtPause;
      const p = Math.min(1, el / STEP_MS);
      if (timer) timer.style.transform = `scaleX(${paused ? 0 : p})`;
      // Live readouts for the open step.
      if (a === 1 && lease) lease.textContent = String(Math.max(0, Math.round(120 - Math.min(el, 3400) / 100)));
      if (a === 2 && done) done.textContent = String(Math.min(64, Math.floor(Math.max(0, el - 100) / 38)));
      if (a === 2 && vec && Math.random() < 0.25) vec.textContent = `[${rnd()}, ${rnd()}, ${rnd()}, ${rnd()}, ${rnd()}, …]`;
      if (a === 4 && paid) paid.textContent = fmt(paidTo * (1 - Math.pow(1 - Math.min(1, el / 1400), 4)));
      if (running && p >= 1) go(a + 1);
      raf = requestAnimationFrame(tick);
    };
    const start = () => { if (!raf) raf = requestAnimationFrame(tick); };

    // Without motion, show each step's end state.
    if (!motionAllowed()) {
      if (lease) lease.textContent = "86";
      if (done) done.textContent = "64";
    }

    tabs.forEach((b, j) => {
      b.addEventListener("click", () => go(j));
      b.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        go(a + (e.key === "ArrowRight" ? 1 : -1));
        tabs[a]?.focus();
      });
    });
    toggle?.addEventListener("click", () => { paused = !paused; setToggle(); t0 = performance.now() - elapsedAtPause; start(); });
    root.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") hovering = true; });
    root.addEventListener("pointerleave", () => { hovering = false; });

    const io = new IntersectionObserver(([e]) => {
      const was = visible;
      visible = !!e?.isIntersecting;
      if (visible && !was) { go(a); start(); }
    }, { threshold: 0.25 });
    io.observe(root);
    document.addEventListener("astro:before-swap", () => { io.disconnect(); cancelAnimationFrame(raf); }, { once: true });
  }
  document.addEventListener("astro:page-load", initFlow);
</script>
