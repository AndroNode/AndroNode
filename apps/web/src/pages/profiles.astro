---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import ProfilesLab from "../islands/ProfilesLab";
---
<Layout title="Model Profiles" description="The first release supports one embedding profile. Every device runs the same model, tokenizer, runtime and precision, so results can be checked against a reference.">
  <PageHero eyebrow="Model Profiles · Simulation" title="One exact model setup per task type" lead="The first release supports one embedding profile. Every device runs the same model, tokenizer, runtime and precision, so results can be checked against a reference." />
  <section class="mx-auto max-w-7xl px-4 sm:px-6">
    <ProfilesLab client:load />
  </section>
</Layout>
