---
import Layout from "../layouts/Layout.astro";
import SessionCard from "../islands/SessionCard";
import HeroScene from "../islands/HeroScene";
import AndroidComingSoon from "../components/AndroidComingSoon.astro";
import FlowPipeline from "../components/FlowPipeline.astro";
import site from "../site.config";

const story = [
  {
    k: "01",
    title: "Everyday hardware",
    body: "Phones, tablets and later Android TV boxes that already sit plugged in could contribute. Each device works alone on a complete small task; the network never pools memory or splits a big model across devices.",
    href: "/contribute",
    cta: "Check a hypothetical device",
  },
  {
    k: "02",
    title: "Small, suitable tasks",
    body: "The first workload is batch text embeddings for approved, non-sensitive English text: up to 64 records per task, 256 tokens per record, a 384-number vector out.",
    href: "/profiles",
    cta: "See the candidate profile",
  },
  {
    k: "03",
    title: "You stay in control",
    body: "Sessions are started on purpose and stay visible. External power, unmetered network, battery and heat limits apply. Stop works at any time and is never penalised.",
    href: "/contribute",
    cta: "Try the session controls",
  },
  {
    k: "04",
    title: "Every result is checked",
    body: "In the first paid design a trusted verifier recomputes every output and compares it within published tolerances. Hashes and blockchains record results; they do not prove correctness.",
    href: "/verify",
    cta: "Inspect a receipt",
  },
  {
    k: "05",
    title: "Paid for accepted work",
    body: "Customers fund orders. Only accepted records are charged: 75% goes to contributors, 25% to the service pool. Idle time, uptime or holding a token earns nothing.",
    href: "/rewards",
    cta: "Follow the payment states",
  },
];

const facts = ["64 records per task", "384-number vectors", "256 tokens per record", "Every result recomputed", "75% to contributors", "Stop any time, never penalised", "Leases expire in 120 s", "External power and Wi-Fi only", "Paid only for accepted work"];
const guards = [
  { k: "power", t: "External power and unmetered Wi-Fi only", d: "Work only starts while the phone is charging and on an unmetered network. Unplug it and no new task is taken.", icon: '<path d="M9 2v5M15 2v5M6 7h12v4a6 6 0 0 1-12 0zM12 17v5"/>', meter: '<i></i><i></i><i></i><i></i>' },
  { k: "heat", t: "Battery and heat limits pause work automatically", d: "The owner sets the battery floor and temperature ceiling. Crossing either one pauses the session.", icon: '<path d="M14 14.8V4a2 2 0 0 0-4 0v10.8a4 4 0 1 0 4 0z"/><path d="M12 18v-6"/>', meter: '<svg viewBox="0 0 64 22" width="64" height="22"><path d="M0 7h64" stroke="#ff9466" stroke-width="1" stroke-dasharray="3 3" opacity=".7"/><polyline class="sg-line" points="0,19 8,18 16,17 24,15 32,14 40,11 48,9 54,8 60,14 64,17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" pathLength="100"/></svg>' },
  { k: "earn", t: "Earn only for verified results, never for idle time", d: "Idle time, uptime or holding a token earns nothing. Only records the verifier accepts are paid.", icon: '<path d="M12 2.5 4.5 5.5v6c0 4.6 3.2 8.6 7.5 10 4.3-1.4 7.5-5.4 7.5-10v-6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/>', meter: '<span class="sg-idle">idle $0</span><span class="sg-ok">✓ paid</span>' },
];
const stages = [
  { t: "Engineering prototype", d: "Android client, one embedding profile, coordinator, reference verifier, testnet settlement. 20 supervised devices.", st: "In progress on testnet", chips: ["Android client", "Embedding profile", "Coordinator", "Reference verifier", "Testnet settlement", "20 devices"] },
  { t: "Closed network pilot", d: "About 100 approved devices, one million reference-checked records over seven days.", st: "Gated", chips: ["~100 devices", "1M checked records", "7 days"] },
  { t: "Limited paid beta", d: "Audited escrow, published parameters, at least three independent paying customers, low exposure caps.", st: "Gated", chips: ["Audited escrow", "Published parameters", "3+ paying customers", "Low exposure caps"] },
  { t: "Expansion cohorts", d: "Android TV boxes, more profiles and accelerators, each tested separately.", st: "Gated", chips: ["Android TV boxes", "More profiles", "Accelerators"] },
];
const lock = '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/>';
const bars = [38, 62, 45, 80, 55, 92, 40, 70, 58, 86, 48, 74, 66, 95, 52, 78, 44, 68];
// Topographic contour lines behind the hero (computed at build time).
const contours = (() => {
  const out: { d: string; orange: boolean }[] = [];
  const centres: [number, number, number][] = [[300, 650, 9], [1180, 420, 11], [820, 120, 6], [1500, 860, 6], [80, 120, 5]];
  centres.forEach(([cx, cy, n], ci) => {
    for (let k = 1; k <= n; k++) {
      const R = 46 * k;
      const pts: string[] = [];
      for (let i = 0; i <= 96; i++) {
        const t = (i / 96) * Math.PI * 2;
        const r = R * (1 + 0.18 * Math.sin(3 * t + ci + k * 0.35) + 0.09 * Math.sin(5 * t - k * 0.5 + ci * 2) + 0.05 * Math.cos(7 * t + k));
        pts.push(`${(cx + Math.cos(t) * r * 1.35).toFixed(1)},${(cy + Math.sin(t) * r).toFixed(1)}`);
      }
      out.push({ d: `M${pts.join("L")}Z`, orange: ci === 1 && k % 3 === 0 });
    }
  });
  return out;
})();
---
<Layout title={site.displayName} description="AndroNode is a proposed protocol for paid AI inference on everyday Android devices. Explore it through labelled simulations — no wallet, app or account needed." intro>
  <!-- HERO: full-bleed stage with the 3D device constellation -->
  <section class="zone-dark relative isolate -mt-px overflow-hidden text-paper" aria-label="Introduction">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(50%_65%_at_72%_48%,rgba(255,122,69,0.22),transparent_70%),radial-gradient(35%_45%_at_0%_100%,rgba(96,120,255,0.10),transparent_70%),radial-gradient(30%_40%_at_100%_0%,rgba(255,122,69,0.08),transparent_70%)]"></div>
    <svg aria-hidden="true" class="hero-contours pointer-events-none absolute inset-0 -z-20 h-full w-full" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" fill="none">
      {contours.map((c) => <path d={c.d} stroke={c.orange ? "rgba(255,122,69,0.16)" : "rgba(236,238,243,0.06)"} stroke-width="1" vector-effect="non-scaling-stroke" />)}
    </svg>
    <div aria-hidden="true" class="hero-floor pointer-events-none absolute -z-20"></div>
    <svg aria-hidden="true" class="pointer-events-none absolute bottom-[-6%] right-[8%] -z-10 hidden w-[46%] lg:block" viewBox="0 0 800 220" fill="none">
      <ellipse cx="400" cy="110" rx="390" ry="100" stroke="rgba(255,122,69,0.10)" />
      <ellipse cx="400" cy="110" rx="300" ry="76" stroke="rgba(255,122,69,0.18)" />
      <ellipse class="hero-ring-pulse" cx="400" cy="110" rx="210" ry="52" stroke="rgba(255,150,100,0.45)" stroke-width="1.5" />
      <ellipse cx="400" cy="110" rx="120" ry="30" stroke="rgba(255,170,120,0.35)" />
    </svg>

    <div class="absolute inset-0 -z-10 opacity-50 sm:opacity-70 lg:left-[38%] lg:opacity-100">
      <HeroScene client:only="react" />
      <p aria-hidden="true" class="pointer-events-none absolute bottom-8 left-1/2 hidden -translate-x-1/2 items-center gap-2 whitespace-nowrap rounded-full border border-paper/10 bg-paper/[0.04] px-4 py-2 font-mono text-[11px] uppercase tracking-[0.16em] text-paper/55 backdrop-blur lg:flex"><span class="relative inline-flex size-1.5"><span class="ping absolute inset-0 rounded-full bg-orange"></span><span class="relative size-1.5 rounded-full bg-orange"></span></span>Drag to spin · hover a device · click to dispatch</p>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden lg:block">
        <div class="float absolute left-[8%] top-[20%] rounded-2xl border border-paper/15 bg-paper/[0.06] px-4 py-3 shadow-2xl backdrop-blur-md [animation-delay:-1s]">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-paper/50">Task leased</p>
          <p class="mt-1 text-sm font-bold">64 records · 120 s</p>
        </div>
        <div class="float absolute right-[6%] top-[40%] rounded-2xl border border-paper/15 bg-paper/[0.06] px-4 py-3 shadow-2xl backdrop-blur-md [animation-delay:-3s]">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-paper/50">Verifier</p>
          <p class="mt-1 flex items-center gap-2 text-sm font-bold"><span class="grid size-4 place-items-center rounded-full bg-ok text-ink text-[10px]">✓</span> 64 / 64 within tolerance</p>
        </div>
        <div class="float absolute bottom-[18%] left-[16%] rounded-2xl border border-orange/40 bg-orange/10 px-4 py-3 shadow-2xl backdrop-blur-md [animation-delay:-4.5s]">
          <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-paper/50">Provisional reward</p>
          <p class="mt-1 text-sm font-bold text-[#ffc9a8]">+0.0096 test USDC</p>
        </div>
      </div>
    </div>

    <div class="relative grid min-h-[min(calc(100vh-7rem),58rem)] items-center px-[clamp(1.25rem,5vw,8rem)] pb-28 pt-14 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
        <div class="max-w-[40rem]">
          <div class="rise flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-2 rounded-full border border-paper/15 bg-paper/5 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.16em] text-paper/80 backdrop-blur">
              <span class="relative flex size-2"><span class="ping absolute inline-flex size-full rounded-full bg-orange"></span><span class="relative inline-flex size-2 rounded-full bg-orange"></span></span>
              Testnet app live
            </span>
            <a href="#android" class="inline-flex items-center gap-2 rounded-full border border-orange/40 bg-orange/10 px-3 py-1 font-mono text-[11px] uppercase tracking-[0.16em] text-orange-deep backdrop-blur hover:bg-orange/20">
              Android app · coming soon
            </a>
          </div>
          <h1 data-split class="mt-6 text-[2.75rem] font-bold leading-[0.98] tracking-[-0.045em] sm:text-7xl lg:text-[5rem]">
            Everyday devices.<br /><span class="text-shine">Shared intelligence.</span>
          </h1>
          <p data-reveal class="mt-7 max-w-xl text-lg leading-relaxed text-paper/70 [--fx-delay:500ms]">
            {site.displayName} proposes a network where approved Android devices run short AI tasks under limits their owners set, and earn only for results that pass verification.
          </p>
          <div data-reveal class="mt-9 flex flex-wrap gap-3 [--fx-delay:650ms]">
            <a href="/contribute" data-magnetic class="group relative inline-flex min-h-13 items-center gap-2 overflow-hidden rounded-full bg-orange px-7 py-3.5 font-bold text-ink shadow-[0_10px_40px_-10px_rgba(240,120,67,0.8)]">
              <span class="relative z-10">Try the demo</span>
              <span aria-hidden="true" class="relative z-10 transition-transform duration-300 group-hover:translate-x-1">→</span>
              <span aria-hidden="true" class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-700 group-hover:translate-x-full"></span>
            </a>
            <a href="/workloads" data-magnetic class="inline-flex min-h-13 items-center rounded-full border border-paper/25 bg-paper/5 px-7 py-3.5 font-bold text-paper backdrop-blur hover:bg-paper/10">Try a sample workload</a>
          </div>
          <p data-reveal class="mt-6 max-w-lg text-sm text-paper/50 [--fx-delay:800ms]">
            Not live on mainnet. No app download or payment needed. Panels marked <span class="rounded-full bg-paper/10 px-1.5 font-mono text-[11px] text-paper/80">◇ SIMULATION</span> use bundled examples.
          </p>
        </div>
    </div>

    <a href="#facts" class="absolute bottom-7 left-[clamp(1.25rem,5vw,8rem)] hidden items-center gap-3 font-mono text-[11px] uppercase tracking-[0.2em] text-paper/50 hover:text-paper sm:flex">
      <span class="relative h-9 w-5 rounded-full border border-paper/30"><span class="absolute left-1/2 top-1.5 h-2 w-0.5 -translate-x-1/2 rounded bg-orange [animation:an-scrollcue_1.8s_ease-in-out_infinite]"></span></span>
      Scroll to explore
    </a>
  </section>

  <!-- FACTS TICKER -->
  <section id="facts" class="relative overflow-hidden border-b border-line py-6" aria-label="Design parameters">
    <div class="marquee gap-10 pr-10">
      {[...facts, ...facts].map((f, i) => (
        <span class="flex items-center gap-10 whitespace-nowrap text-lg font-bold tracking-tight text-charcoal/80 sm:text-xl" aria-hidden={i >= facts.length ? "true" : undefined}>
          {f}<span class="inline-block size-2 rotate-45 bg-orange"></span>
        </span>
      ))}
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-paper to-transparent"></div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-paper to-transparent"></div>
  </section>

  <!-- NUMBERS -->
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6" aria-label="Key numbers from the protocol design">
    <dl data-stagger class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div data-spotlight data-tilt="6" class="relative overflow-hidden rounded-[22px] border border-line bg-white/60 p-6">
        <dt class="sr-only">Records in one task</dt>
        <dd>
          <div class="viz-dots" aria-hidden="true">{Array.from({ length: 64 }, (_, i) => <i style={`--i:${i}`}></i>)}</div>
          <span data-count="64" class="tabular font-display mt-6 block text-5xl font-bold tracking-[-0.04em] sm:text-6xl">64</span>
          <span class="mt-2 block font-bold">records in one task</span>
          <span class="mt-1 block text-sm text-charcoal-60">complete, small, self-contained</span>
        </dd>
      </div>
      <div data-spotlight data-tilt="6" class="relative overflow-hidden rounded-[22px] border border-line bg-white/60 p-6">
        <dt class="sr-only">Numbers per vector</dt>
        <dd>
          <div class="viz-bars" aria-hidden="true">{bars.map((h, i) => <i style={`--i:${i};--h:${h}%`}></i>)}</div>
          <span data-count="384" class="tabular font-display mt-6 block text-5xl font-bold tracking-[-0.04em] sm:text-6xl">384</span>
          <span class="mt-2 block font-bold">numbers per vector</span>
          <span class="mt-1 block text-sm text-charcoal-60">MiniLM-class embeddings</span>
        </dd>
      </div>
      {[
        { n: 75, l: "of each charge to contributors", sub: "25% to the service pool", p: 75 },
        { n: 100, l: "of outputs recomputed", sub: "by a trusted verifier in v1", p: 100 },
      ].map((x) => (
        <div data-spotlight data-tilt="6" class="relative overflow-hidden rounded-[22px] border border-line bg-white/60 p-6">
          <dt class="sr-only">{x.l}</dt>
          <dd>
            <svg class="viz-ring h-12 w-12 -rotate-90" viewBox="0 0 40 40" aria-hidden="true" style={`--p:${x.p}`}>
              <circle cx="20" cy="20" r="15.9" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="4" />
              <circle class="val" cx="20" cy="20" r="15.9" fill="none" stroke="#ff7a45" stroke-width="4" stroke-linecap="round" pathLength="100" />
            </svg>
            <span data-count={x.n} data-suffix="%" class="tabular font-display mt-6 block text-5xl font-bold tracking-[-0.04em] sm:text-6xl">{x.n}%</span>
            <span class="mt-2 block font-bold">{x.l}</span>
            <span class="mt-1 block text-sm text-charcoal-60">{x.sub}</span>
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- STORY: sticky phone, screen follows the active step -->
  <section id="story" data-active="0" class="relative border-y border-line bg-peach-soft" aria-labelledby="story-h">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-60 [background-image:radial-gradient(rgba(255,255,255,0.07)_1px,transparent_1px)] [background-size:22px_22px] [mask-image:linear-gradient(transparent,black_20%,black_80%,transparent)]"></div>
    <div class="relative mx-auto max-w-7xl px-4 py-24 sm:px-6">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
        <h2 id="story-h" data-split class="max-w-2xl text-4xl font-bold leading-[1.02] tracking-[-0.035em] sm:text-6xl">How a phone could do useful AI work.</h2>
        <p data-reveal class="max-w-md text-lg text-charcoal-80 lg:justify-self-end">Five connected ideas. Scroll through them, then open any one to try it.</p>
      </div>
      <div class="mt-16 grid gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20">
        <div class="hidden lg:block">
          <div class="sticky top-[18vh] flex items-center gap-8">
            <div class="flex flex-col gap-2" aria-hidden="true">{story.map((_, i) => <span class="story-dot" data-s={i}></span>)}</div>
            <div aria-hidden="true" class="relative mx-auto h-[min(64vh,36rem)] aspect-[9/18.5] rounded-[2.6rem] border border-white/10 bg-gradient-to-b from-[#1b2130] to-[#0e1118] p-2.5 shadow-[0_50px_120px_-40px_rgba(255,122,69,0.55),inset_0_0_0_1px_rgba(255,255,255,0.04)]">
              <div class="absolute left-1/2 top-4 z-10 h-5 w-20 -translate-x-1/2 rounded-full bg-black"></div>
              <div class="relative h-full overflow-hidden rounded-[2.1rem] bg-[#0b0d12] text-snow">
                <div class="absolute inset-0 bg-[radial-gradient(80%_50%_at_50%_0%,rgba(255,122,69,0.18),transparent_70%)]"></div>
                <!-- 0 hardware -->
                <div class="story-screen" data-s="0">
                  <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.2em] text-snow/50">Device check</p>
                  <p class="mt-2 text-xl font-bold">Ready to help</p>
                  <div class="mt-8 grid place-items-center">
                    <div class="relative grid size-32 place-items-center rounded-full border border-orange/40" style="animation:story-pulse 2s ease-out infinite">
                      <span class="text-4xl" style="animation:story-bolt 1.6s ease-in-out infinite">⚡</span>
                    </div>
                  </div>
                  <ul class="mt-8 grid gap-2 text-xs">
                    <li class="flex justify-between rounded-lg bg-white/5 px-3 py-2"><span>External power</span><span class="text-ok">● on</span></li>
                    <li class="flex justify-between rounded-lg bg-white/5 px-3 py-2"><span>Wi-Fi, unmetered</span><span class="text-ok">● on</span></li>
                    <li class="flex justify-between rounded-lg bg-white/5 px-3 py-2"><span>Battery</span><span>92%</span></li>
                  </ul>
                </div>
                <!-- 1 tasks -->
                <div class="story-screen" data-s="1">
                  <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.2em] text-snow/50">Task leased · 120 s</p>
                  <p class="mt-2 text-xl font-bold">64 short records</p>
                  <ul class="mt-6 grid gap-1.5 font-mono text-[10px]">
                    {["rec-001 · 212 tokens", "rec-002 · 98 tokens", "rec-003 · 256 tokens", "rec-004 · 143 tokens", "rec-005 · 77 tokens", "rec-006 · 190 tokens", "rec-007 · 64 tokens"].map((r, i) => (
                      <li class="story-row flex items-center justify-between rounded-md bg-white/5 px-2.5 py-1.5" style={`animation-delay:${i * 90}ms`}><span>{r}</span><span class="text-orange">→ 384</span></li>
                    ))}
                  </ul>
                  <div class="mt-5 h-1.5 overflow-hidden rounded-full bg-white/10"><div class="h-full w-[62%] rounded-full bg-orange" style="animation:story-fill 2.4s ease-out"></div></div>
                </div>
                <!-- 2 control -->
                <div class="story-screen" data-s="2">
                  <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.2em] text-snow/50">Your limits</p>
                  <p class="mt-2 text-xl font-bold">Session · 30 min</p>
                  <ul class="mt-6 grid gap-2.5 text-xs">
                    {["Pause above 40 °C", "Pause below 80% battery", "Wi-Fi only", "Visible while running"].map((t) => (
                      <li class="flex items-center justify-between rounded-lg bg-white/5 px-3 py-2.5"><span>{t}</span><span class="relative h-5 w-9 rounded-full bg-orange"><span class="absolute right-0.5 top-0.5 size-4 rounded-full bg-white"></span></span></li>
                    ))}
                  </ul>
                  <div class="mt-8 grid place-items-center"><span class="grid size-20 place-items-center rounded-full bg-orange text-sm font-bold text-ink" style="animation:story-pulse 2s ease-out infinite">Stop</span></div>
                </div>
                <!-- 3 verify -->
                <div class="story-screen" data-s="3">
                  <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.2em] text-snow/50">Verifier</p>
                  <p class="mt-2 text-xl font-bold">Recomputed and compared</p>
                  <div class="relative mx-auto mt-6 size-32">
                    <svg class="absolute inset-0 size-full -rotate-90" viewBox="0 0 40 40"><circle cx="20" cy="20" r="15.9" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="3" /><circle cx="20" cy="20" r="15.9" fill="none" stroke="#4cc38a" stroke-width="3" stroke-linecap="round" pathLength="100" stroke-dasharray="100" style="animation:story-ring 1.6s ease-out both" /></svg>
                    <p class="font-display absolute inset-0 grid place-items-center text-2xl font-bold tabular-nums tracking-tight">64/64</p>
                  </div>
                  <ul class="mt-8 grid gap-1.5 font-mono text-[10px]">
                    <li class="flex justify-between rounded-md bg-white/5 px-2.5 py-1.5"><span>cosine ≥ 0.9999</span><span class="text-ok">✓</span></li>
                    <li class="flex justify-between rounded-md bg-white/5 px-2.5 py-1.5"><span>max error ≤ 0.001</span><span class="text-ok">✓</span></li>
                    <li class="flex justify-between rounded-md bg-white/5 px-2.5 py-1.5"><span>384 dimensions</span><span class="text-ok">✓</span></li>
                  </ul>
                </div>
                <!-- 4 paid -->
                <div class="story-screen" data-s="4">
                  <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.2em] text-snow/50">Accepted</p>
                  <p class="mt-2 text-xl font-bold">Provisional reward</p>
                  <p class="font-display mt-8 text-center text-4xl font-bold tracking-tight text-orange">+0.0096</p>
                  <p class="text-center text-xs text-snow/60">test USDC</p>
                  <div class="mt-8 flex h-3 overflow-hidden rounded-full"><div class="bg-orange" style="width:75%;animation:story-fill 1.4s ease-out"></div><div class="flex-1 bg-white/20"></div></div>
                  <div class="mt-2 flex justify-between text-[10px] text-snow/60"><span>75% contributors</span><span>25% pool</span></div>
                  <p class="mt-8 rounded-lg bg-white/5 px-3 py-2 text-center text-[11px] text-snow/70">Idle time never earns</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <ol class="grid gap-6 lg:gap-0">
          {story.map((s, i) => (
            <li data-story-step={i} class:list={["story-step lg:flex lg:min-h-[62vh] lg:items-center", i === 0 && "active"]}>
