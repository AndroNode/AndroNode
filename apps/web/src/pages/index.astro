  <!-- STATUS -->
  <section class="mx-auto max-w-7xl px-4 py-24 sm:px-6" aria-labelledby="status-h">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.2fr]">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p data-reveal class="font-mono text-xs uppercase tracking-[0.18em] text-charcoal-60">Release status</p>
        <h2 id="status-h" data-split class="mt-3 text-4xl font-bold leading-[1.02] tracking-[-0.035em] sm:text-6xl">Where it stands today.</h2>
        <p data-reveal class="mt-5 text-lg text-charcoal-80">The protocol describes a design baseline, not an operating service. Releases advance only when evidence gates pass, never by calendar date.</p>
        <div data-reveal class="mt-8 rounded-2xl border border-line bg-white/60 p-4">
          <div class="flex items-center justify-between font-mono text-[11px] uppercase tracking-widest text-charcoal-60"><span>Gates</span><span><span class="text-orange">1</span> of 4 in progress</span></div>
          <div id="tl-meter" class="mt-3 grid grid-cols-4 gap-2">
            {stages.map((s, i) => (
              <button type="button" data-tl-go={i} class:list={["tl-seg group relative h-12 overflow-hidden rounded-xl border text-left", i === 0 ? "tl-seg-live border-orange/60" : "border-line"]} aria-label={`Go to stage ${i + 1}: ${s.t}`}>
                {i === 0 ? <span aria-hidden="true" class="tl-stripes absolute inset-0"></span> : <svg aria-hidden="true" viewBox="0 0 24 24" class="tl-lock absolute right-2 top-2 size-3.5 text-charcoal-60" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={lock} />}
                <span class="absolute bottom-1.5 left-2 font-mono text-[11px] font-bold">0{i + 1}</span>
              </button>
            ))}
          </div>
        </div>
        <a href="/docs#status" data-reveal class="group mt-7 inline-flex min-h-11 items-center gap-2 font-bold underline decoration-orange decoration-2 underline-offset-4">Read the release status <span class="inline-block transition-transform duration-300 group-hover:translate-x-1.5">→</span></a>
      </div>
      <ol id="timeline" class="relative grid gap-4 pl-8" aria-label="Roadmap stages">
        <span aria-hidden="true" class="tl-rail"><i></i></span>
        {stages.map((s, i) => (
          <li id={`tl-${i}`} data-reveal="left" data-spotlight style={`--fx-delay:${i * 90}ms`} class:list={["tl-item group relative scroll-mt-32 rounded-[22px] border border-line bg-white/60 p-5 sm:p-6", i === 0 && "lit tl-live glow-border"]}>
            <span aria-hidden="true" class="tl-num">0{i + 1}</span>
            <span class="tl-dot absolute -left-[41px] top-7 grid size-5 place-items-center rounded-full border-2 border-line bg-paper">{i === 0 && <span class="ping absolute inset-0 rounded-full bg-orange/40"></span>}</span>
            <div class="relative flex flex-wrap items-center gap-2">
              <p class="font-mono text-xs text-charcoal-60">Stage {i + 1}</p>
              <span class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 font-mono text-[11px] ${i === 0 ? "bg-orange/15 text-orange-deep" : "bg-peach text-charcoal-80"}`}>
                {i === 0 ? <span class="relative inline-flex size-1.5"><span class="ping absolute inset-0 rounded-full bg-orange"></span><span class="relative size-1.5 rounded-full bg-orange"></span></span> : <svg aria-hidden="true" viewBox="0 0 24 24" class="tl-lock size-3" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={lock} />}
                {s.st}
              </span>
            </div>
            <p class="relative mt-2 text-xl font-bold sm:text-2xl">{s.t}</p>
            <p class="relative mt-1.5 max-w-xl text-sm text-charcoal-80">{s.d}</p>
            <ul class="relative mt-4 flex flex-wrap gap-2" aria-label="What this stage needs">
              {s.chips.map((c, j) => <li class:list={["tl-chip rounded-full border px-2.5 py-1 font-mono text-[11px]", i === 0 ? "border-orange/35 bg-orange/[0.08] text-snow" : "border-line text-charcoal-80"]} style={`--j:${j}`}>{c}</li>)}
            </ul>
            {i === 0 && <div aria-hidden="true" class="relative mt-5 h-1.5 overflow-hidden rounded-full bg-snow/[0.06]"><span class="tl-build absolute inset-y-0 left-0 w-1/3 rounded-full"></span></div>}
