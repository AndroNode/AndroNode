  <!-- CTA -->
  <section class="px-2 pb-6 sm:px-4" aria-labelledby="try-h">
    <div data-reveal="scale" data-spotlight class="grain relative isolate overflow-hidden zone-dark rounded-[28px] bg-charcoal px-6 py-16 text-paper ring-1 ring-white/5 sm:rounded-[36px] sm:px-12 sm:py-24">
      <div aria-hidden="true" class="aurora"><i></i><i></i><i></i></div>
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 opacity-[0.08] [background-image:linear-gradient(rgba(255,255,255,.6)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.6)_1px,transparent_1px)] [background-size:44px_44px] [mask-image:radial-gradient(60%_70%_at_50%_50%,black,transparent)]"></div>
      <div class="relative mx-auto max-w-4xl text-center">
        <h2 id="try-h" data-split class="text-4xl font-bold leading-[1.02] tracking-[-0.04em] sm:text-7xl">Try it, then read the details.</h2>
        <p data-reveal class="mx-auto mt-5 max-w-xl text-lg text-paper/70">Run a device session, send a sample batch, inspect why a result is accepted, and see what an accepted record would pay. No wallet needed.</p>
        <div data-reveal class="mt-10 flex flex-wrap justify-center gap-3">
          <a href="/contribute" data-magnetic class="btn-shine inline-flex min-h-13 items-center rounded-full bg-orange px-7 py-3.5 font-bold text-ink shadow-[0_10px_40px_-10px_rgba(240,120,67,0.8)]">Try a device session</a>
          <a href="/app" data-magnetic class="inline-flex min-h-13 items-center rounded-full border border-paper/25 bg-paper/5 px-7 py-3.5 font-bold backdrop-blur hover:bg-paper/10">Open the testnet app</a>
          <a href="/docs" data-magnetic class="inline-flex min-h-13 items-center rounded-full px-5 py-3.5 font-bold text-paper/80 underline decoration-orange decoration-2 underline-offset-4 hover:text-paper">Read the docs</a>
        </div>
      </div>
    </div>
  </section>
<script>
  // Story: the step nearest the middle of the screen drives the sticky phone.
  // Timeline: the rail fills with scroll and lights each stage it reaches.
  function initStory() {
    const story = document.getElementById("story");
    const steps = [...document.querySelectorAll<HTMLElement>("[data-story-step]")];
    const tl = document.getElementById("timeline");
    const items = [...document.querySelectorAll<HTMLElement>(".tl-item")];
    if (!story || !tl) return;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const i = (e.target as HTMLElement).dataset.storyStep!;
        if (story.dataset.active === i) continue;
        story.dataset.active = i;
        steps.forEach((s) => s.classList.toggle("active", s.dataset.storyStep === i));
        story.querySelector<HTMLElement>(`.story-screen[data-s="${i}"]`)?.getAnimations({ subtree: true }).forEach((a) => { a.cancel(); a.play(); });
      }
    }, { rootMargin: "-45% 0px -45% 0px" });
    steps.forEach((s) => io.observe(s));
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        const r = tl.getBoundingClientRect();
        const mid = innerHeight * 0.6;
        const p = Math.max(0, Math.min(1, (mid - r.top) / r.height));
        tl.style.setProperty("--p", p.toFixed(3));
        items.forEach((it) => it.classList.toggle("lit", it.getBoundingClientRect().top + 30 < mid || it === items[0]));
      });
    };
    addEventListener("scroll", onScroll, { passive: true });
    onScroll();
    // Gate meter: click a segment to jump to its stage; the stage nearest the middle is outlined.
    const segs = [...document.querySelectorAll<HTMLElement>("[data-tl-go]")];
    segs.forEach((b) => b.addEventListener("click", () => {
      const el = document.getElementById(`tl-${b.dataset.tlGo}`);
      if (!el) return;
      const lenis = (window as Window & { __lenis?: { scrollTo: (t: HTMLElement, o: { offset: number }) => void } | null }).__lenis;
      if (lenis) lenis.scrollTo(el, { offset: -(innerHeight - el.offsetHeight) / 2 });
      else el.scrollIntoView({ behavior: "smooth", block: "center" });
    }));
    const near = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { const i = (e.target as HTMLElement).id.slice(3); segs.forEach((b) => b.classList.toggle("on", b.dataset.tlGo === i)); }
    }, { rootMargin: "-45% 0px -45% 0px" });
    items.forEach((it) => near.observe(it));
    // Session telemetry chips drift a little, like a live readout (simulated).
    const temp = document.getElementById("sess-temp");
    const batt = document.getElementById("sess-batt");
    let tv = 31.4, bv = 92;
    const jitter = setInterval(() => {
      if (document.hidden || !temp) return;
      tv = Math.max(30.6, Math.min(33.2, tv + (Math.random() - 0.48) * 0.3));
      temp.textContent = tv.toFixed(1);
      if (batt && Math.random() < 0.08) { bv = bv >= 96 ? 92 : bv + 1; batt.textContent = String(bv); }
    }, 1100);
    document.addEventListener("astro:before-swap", () => { io.disconnect(); near.disconnect(); clearInterval(jitter); removeEventListener("scroll", onScroll); }, { once: true });
  }
  document.addEventListener("astro:page-load", initStory);
</script>
</Layout>
