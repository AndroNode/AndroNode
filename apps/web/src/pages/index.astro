          <span class="sess-chip" style="--x:-7%;--y:-9%;--d:0s"><i class="bg-orange"></i>CPU · 2 threads</span>
          <span class="sess-chip" style="--x:72%;--y:-11%;--d:-1.6s"><i class="bg-ok"></i>Battery <b id="sess-batt">92</b>%</span>
          <span class="sess-chip" style="--x:-4%;--y:103%;--d:-3.1s"><i class="bg-warn"></i><b id="sess-temp">31.4</b> °C · limit 40</span>
          <span class="sess-chip" style="--x:68%;--y:104%;--d:-4.4s"><i class="bg-orange"></i>Wi-Fi · unmetered</span>
