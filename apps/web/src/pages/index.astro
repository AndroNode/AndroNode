      <div class="relative">
        <div aria-hidden="true" class="sess-radar"><i></i><i></i><i></i><b></b></div>
        <div data-reveal="scale" data-tilt="4" class="glow-border relative rounded-[26px] text-charcoal transition-transform duration-300">
          <div class="rounded-[26px] bg-paper/[0.06] p-2 ring-1 ring-paper/10 shadow-[0_40px_120px_-30px_rgba(255,122,69,0.55)]">
