---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import DeployEscrow from "../../islands/app/DeployEscrow";
---
<Layout title="Deploy escrow" description="Deploy the AndroNode test USDC token and escrow contract to Robinhood Chain Testnet from your own wallet. Testnet only." noindex>
  <PageHero title="Deploy the escrow contract" lead="Your wallet signs the deploy, so no private key is shared with anyone. This page only works on Robinhood Chain Testnet." compact>
    <Fragment slot="eyebrow"><a href="/app" class="hover:underline">Testnet app</a> · Operator setup</Fragment>
  </PageHero>
  <section class="mx-auto max-w-7xl px-4 sm:px-6">
    <DeployEscrow client:only="react" />
  </section>
</Layout>
