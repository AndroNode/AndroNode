---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import ContributorApp from "../../islands/app/ContributorApp";
---
<Layout title="Contributor dashboard" description="Run a test node and track rewards on the AndroNode testnet. Test funds only." noindex>
  <PageHero title="Run a test node and track rewards" compact>
    <Fragment slot="eyebrow"><a href="/app" class="hover:underline">Testnet app</a> · Contributor dashboard</Fragment>
  </PageHero>
  <section class="mx-auto max-w-7xl px-4 sm:px-6">
    <ContributorApp client:only="react" />
  </section>
</Layout>
