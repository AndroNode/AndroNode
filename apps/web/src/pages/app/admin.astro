---
import Layout from "../../layouts/Layout.astro";
import AdminApp from "../../islands/app/AdminApp";
---
<Layout title="Admin console" description="Settle, reconcile and resolve on the AndroNode testnet. Test funds only." noindex>
  <section class="mx-auto max-w-7xl px-4 pb-4 pt-10 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-charcoal-60"><a href="/app" class="hover:underline">Testnet app</a> · Admin console</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Settle, reconcile and resolve</h1>
  </section>
  <section class="mx-auto max-w-7xl px-4 sm:px-6">
    <AdminApp client:only="react" />
  </section>
</Layout>
