---
import Layout from "../../layouts/Layout.astro";
const cards = [
  { href: "/app/customer", t: "Customer", b: "Quote a batch of records, fund escrow with test USDC (or simulated funding), track progress, download verified vectors and claim refunds." },
  { href: "/app/contributor", t: "Contributor", b: "Register a test node (this browser or the command-line tool), run sessions, and watch rewards move from provisional to claimable." },
  { href: "/app/admin", t: "Admin", b: "Reconcile the ledger, prepare 2-of-3 Safe settlement transactions, resolve disputes and manage device status." },
  { href: "/app/deploy", t: "Deploy escrow", b: "Operator setup: deploy the escrow contract to Base Sepolia from your own wallet, with no private key shared." },
];
---
<Layout title="Testnet app" description="Use the AndroNode coordinator on Base Sepolia with test funds: customer, contributor and admin dashboards.">
  <section class="mx-auto max-w-7xl px-4 pb-8 pt-12 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-[0.18em] text-charcoal-60">Testnet app · Base Sepolia</p>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight sm:text-5xl">The real pipeline, with test money.</h1>
    <p class="mt-4 max-w-2xl text-lg text-charcoal-80">Unlike the simulations, these dashboards talk to the live coordinator: wallet sign-in, signed device leases, server-side verification and escrow settlement. Only testnet tokens are used. Never send real funds.</p>
  </section>
  <section class="mx-auto grid max-w-7xl gap-4 px-4 sm:px-6 md:grid-cols-3">
    {cards.map((c) => (
      <a href={c.href} class="group flex flex-col rounded-[var(--radius-card)] border border-line bg-white/60 p-6 hover:border-charcoal">
        <h2 class="text-xl font-bold">{c.t}</h2>
        <p class="mt-2 flex-1 text-sm text-charcoal-80">{c.b}</p>
        <span class="mt-4 font-bold underline decoration-orange decoration-2 underline-offset-4">Open →</span>
      </a>
    ))}
  </section>
  <section class="mx-auto mt-10 max-w-7xl px-4 sm:px-6">
    <div class="rounded-[var(--radius-card)] border border-orange/40 bg-peach-soft p-6 text-sm leading-relaxed">
      <h2 class="text-base font-bold">Before you start</h2>
      <ul class="mt-2 list-disc pl-5">
        <li>Use a wallet that holds only testnet assets. Signing in costs no gas.</li>
        <li>Until the escrow contract is deployed, funding and settlement are simulated and labelled as such.</li>
        <li>The pipeline test profile uses deterministic hash vectors, not a real model. It exists to exercise leasing, verification and payment.</li>
        <li>Testnet balances have no value and can be reset.</li>
      </ul>
    </div>
  </section>
</Layout>
