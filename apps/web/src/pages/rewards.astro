---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import RewardsLab from "../islands/RewardsLab";
---
<Layout title="Rewards & Settlement" description="See how 75% of each accepted charge becomes a provisional reward, then claimable on-chain, then withdrawn by you. Refunds go back to the customer.">
  <PageHero eyebrow="Rewards & Settlement · Simulation" title="From accepted work to your wallet" lead="See how 75% of each accepted charge becomes a provisional reward, then claimable on-chain, then withdrawn by you. Refunds go back to the customer." />
  <section class="mx-auto max-w-7xl px-4 sm:px-6">
    <RewardsLab client:load />
  </section>
</Layout>
